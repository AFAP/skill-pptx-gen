{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ppt-gen/deck.schema.json",
  "title": "ppt-gen deck",
  "type": "object",
  "required": [
    "slides"
  ],
  "properties": {
    "dslVersion": {
      "type": "integer",
      "minimum": 1,
      "default": 3
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    },
    "style": {
      "type": "string"
    },
    "styleClasses": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "theme": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/theme"
        }
      ]
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slide"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "theme": {
      "type": "object",
      "properties": {
        "extends": {
          "type": "string"
        },
        "background": {
          "$ref": "#/$defs/color"
        },
        "surface": {
          "$ref": "#/$defs/color"
        },
        "surfaceAlt": {
          "$ref": "#/$defs/color"
        },
        "primary": {
          "$ref": "#/$defs/color"
        },
        "accent": {
          "$ref": "#/$defs/color"
        },
        "accentText": {
          "$ref": "#/$defs/color"
        },
        "onAccent": {
          "$ref": "#/$defs/color"
        },
        "text": {
          "$ref": "#/$defs/color"
        },
        "textSecondary": {
          "$ref": "#/$defs/color"
        },
        "border": {
          "$ref": "#/$defs/color"
        },
        "palette": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/color"
          },
          "minItems": 1
        },
        "fontFamily": {
          "type": "string"
        },
        "fontScale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "radius": {
          "type": "number",
          "minimum": 0
        },
        "pagePadding": {
          "type": "number",
          "minimum": 0
        },
        "titleMarker": {
          "enum": [
            "bar",
            "line"
          ]
        },
        "footer": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "slide": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "layout": {
          "enum": [
            "cover",
            "section",
            "agenda",
            "catalog",
            "cards",
            "content-grid",
            "metrics",
            "data",
            "dashboard",
            "split",
            "image-split",
            "comparison",
            "timeline",
            "pipeline",
            "chart-insight",
            "quote",
            "ending",
            "raw"
          ]
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "eyebrow": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "speakerNotes": {
          "type": "string"
        },
        "footerLabel": {
          "type": "string"
        },
        "brand": {
          "type": "string"
        },
        "footer": {
          "type": "boolean"
        },
        "dark": {
          "type": "boolean"
        },
        "contrast": {
          "type": "boolean"
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "contentTitle": {
          "type": "string"
        },
        "heading": {
          "type": "string"
        },
        "centerLabel": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "items": {
          "type": "array"
        },
        "metrics": {
          "type": "array"
        },
        "bullets": {
          "type": "array"
        },
        "insights": {
          "type": "array"
        },
        "chart": {
          "type": "object"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "layout"
          ]
        },
        {
          "required": [
            "elements"
          ]
        }
      ],
      "additionalProperties": true
    },
    "element": {
      "type": "object",
      "required": [
        "elType"
      ],
      "properties": {
        "elType": {
          "enum": [
            "text",
            "image",
            "image-svg",
            "shape-rect",
            "shape-circle",
            "shape-line",
            "shape-arrow",
            "shape-path",
            "curve-quadratic",
            "chart",
            "table",
            "connector-s",
            "connector-elbow",
            "arc-segment",
            "group",
            "repeat",
            "text-path"
          ]
        },
        "id": {
          "type": "string"
        },
        "styleClass": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          ]
        },
        "role": {
          "type": "string"
        },
        "sourcePath": {
          "type": "string"
        },
        "originPath": {
          "type": "string",
          "description": "编译器生成的追踪路径，不代表文字可回写"
        },
        "x": {
          "$ref": "#/$defs/numberOrBinding"
        },
        "y": {
          "$ref": "#/$defs/numberOrBinding"
        },
        "width": {
          "$ref": "#/$defs/positiveNumberOrBinding"
        },
        "height": {
          "$ref": "#/$defs/positiveNumberOrBinding"
        },
        "opacity": {
          "$ref": "#/$defs/unitNumberOrBinding"
        },
        "rotation": {
          "$ref": "#/$defs/numberOrBinding"
        },
        "allowOverflow": {
          "type": "boolean"
        },
        "allowOverlap": {
          "type": "boolean"
        },
        "scale": {
          "$ref": "#/$defs/positiveNumberOrBinding"
        },
        "stepX": {
          "$ref": "#/$defs/numberOrBinding"
        },
        "stepY": {
          "$ref": "#/$defs/numberOrBinding"
        },
        "columns": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "$ref": "#/$defs/binding"
            }
          ]
        },
        "defaults": {
          "type": "object"
        },
        "anchor": {
          "type": "object",
          "required": [
            "to"
          ],
          "properties": {
            "to": {
              "type": "string",
              "minLength": 1
            },
            "edge": {
              "enum": [
                "left",
                "right",
                "top",
                "bottom",
                "center"
              ]
            },
            "align": {
              "enum": [
                "left",
                "right",
                "top",
                "bottom",
                "center"
              ]
            },
            "gap": {
              "$ref": "#/$defs/numberOrBinding"
            },
            "dx": {
              "$ref": "#/$defs/numberOrBinding"
            },
            "dy": {
              "$ref": "#/$defs/numberOrBinding"
            }
          },
          "additionalProperties": false
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          },
          "minItems": 1
        },
        "items": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1
            },
            {
              "$ref": "#/$defs/binding"
            }
          ]
        },
        "template": {
          "oneOf": [
            {
              "$ref": "#/$defs/element"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/element"
              },
              "minItems": 1
            }
          ]
        },
        "text": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "path": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "data": {},
        "prompt": {
          "type": "string"
        },
        "pointArr": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          },
          "minItems": 2
        },
        "webUnsupported": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "coordinateMode": {
          "enum": [
            "auto",
            "local",
            "absolute"
          ],
          "description": "shape-path coordinate mode"
        }
      },
      "additionalProperties": true
    },
    "point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "$ref": "#/$defs/numberOrBinding"
        },
        "y": {
          "$ref": "#/$defs/numberOrBinding"
        }
      },
      "additionalProperties": true
    },
    "color": {
      "type": "string",
      "description": "HEX, rgb()/rgba(), or a theme token such as $primary"
    },
    "numberOrBinding": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/binding"
        }
      ]
    },
    "positiveNumberOrBinding": {
      "oneOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "$ref": "#/$defs/binding"
        }
      ]
    },
    "unitNumberOrBinding": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "$ref": "#/$defs/binding"
        }
      ]
    },
    "binding": {
      "type": "string",
      "pattern": "^\\{\\{\\s*[A-Za-z_][\\w.]*\\s*\\}\\}$"
    }
  }
}
