{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-ppt-gen/deck.schema.json",
  "title": "ai-ppt-gen deck",
  "type": "object",
  "required": ["slides"],
  "properties": {
    "dslVersion": { "type": "integer", "minimum": 1, "default": 2 },
    "meta": { "type": "object", "additionalProperties": true },
    "style": { "type": "string" },
    "theme": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "#/$defs/theme" }
      ]
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slide" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "theme": {
      "type": "object",
      "properties": {
        "extends": { "type": "string" },
        "background": { "$ref": "#/$defs/color" },
        "surface": { "$ref": "#/$defs/color" },
        "surfaceAlt": { "$ref": "#/$defs/color" },
        "primary": { "$ref": "#/$defs/color" },
        "accent": { "$ref": "#/$defs/color" },
        "accentText": { "$ref": "#/$defs/color" },
        "onAccent": { "$ref": "#/$defs/color" },
        "text": { "$ref": "#/$defs/color" },
        "textSecondary": { "$ref": "#/$defs/color" },
        "border": { "$ref": "#/$defs/color" },
        "palette": { "type": "array", "items": { "$ref": "#/$defs/color" }, "minItems": 1 },
        "fontFamily": { "type": "string" },
        "fontScale": { "type": "number", "exclusiveMinimum": 0 },
        "radius": { "type": "number", "minimum": 0 },
        "pagePadding": { "type": "number", "minimum": 0 },
        "titleMarker": { "type": ["string", "boolean"] },
        "footer": { "type": ["boolean", "object"] }
      },
      "additionalProperties": true
    },
    "slide": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "layout": {
          "enum": ["cover", "section", "agenda", "catalog", "cards", "content-grid", "metrics", "data", "dashboard", "split", "image-split", "comparison", "timeline", "pipeline", "chart-insight", "quote", "ending", "raw"]
        },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "eyebrow": { "type": "string" },
        "notes": { "type": "string" },
        "speakerNotes": { "type": "string" },
        "footerLabel": { "type": "string" },
        "brand": { "type": "string" },
        "footer": { "type": "boolean" },
        "dark": { "type": "boolean" },
        "contrast": { "type": "boolean" },
        "columns": { "type": "integer", "minimum": 1, "maximum": 6 },
        "contentTitle": { "type": "string" },
        "heading": { "type": "string" },
        "centerLabel": { "type": "string" },
        "background": { "type": "string" },
        "items": { "type": "array" },
        "metrics": { "type": "array" },
        "bullets": { "type": "array" },
        "insights": { "type": "array" },
        "chart": { "type": "object" },
        "elements": { "type": "array", "items": { "$ref": "#/$defs/element" } }
      },
      "anyOf": [
        { "required": ["layout"] },
        { "required": ["elements"] }
      ],
      "additionalProperties": true
    },
    "element": {
      "type": "object",
      "required": ["elType"],
      "properties": {
        "elType": {
          "enum": ["text", "image", "image-svg", "shape-rect", "shape-circle", "shape-line", "shape-arrow", "shape-path", "curve-quadratic", "chart", "table", "connector-s", "connector-elbow", "arc-segment", "text-path"]
        },
        "id": { "type": "string" },
        "role": { "type": "string" },
        "sourcePath": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "rotation": { "type": "number" },
        "allowOverflow": { "type": "boolean" },
        "allowOverlap": { "type": "boolean" },
        "text": { "type": ["string", "number"] },
        "path": { "type": "string" },
        "url": { "type": "string" },
        "data": {},
        "prompt": { "type": "string" },
        "pointArr": { "type": "array", "items": { "$ref": "#/$defs/point" }, "minItems": 2 },
        "webUnsupported": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "additionalProperties": true
    },
    "color": {
      "type": "string",
      "description": "HEX, rgb()/rgba(), or a theme token such as $primary"
    }
  }
}
